# ── Lotusorium frontend environment ───────────────────────────────────────────
# Copy to .env.local and fill in. Values without NEXT_PUBLIC_ are server-only
# (never shipped to the browser — they power the RSC fetch + BFF proxy).

# Base URL of the NestJS API, including the /api/v1 prefix. Server-only.
# Use 127.0.0.1 (not localhost) in dev: Node's fetch prefers IPv6 ::1, which
# fails against an IPv4-bound API with ECONNREFUSED.
API_BASE_URL=http://127.0.0.1:3000/api/v1

# Public canonical URL of THIS storefront (used for metadata, sitemap, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Cloudinary cloud name — used to build responsive image URLs on the client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
