NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://lotusorium:lotusorium_dev_pw@localhost:5432/lotusorium?schema=public"

# Auth (Phase 2 — placeholders so config validation passes)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# CORS: the Next.js storefront origin
CORS_ORIGIN=http://localhost:3001

# Public site URL — absolute base used to build sitemap/feed URLs (Phase 7).
# Defaults to CORS_ORIGIN when unset.
PUBLIC_SITE_URL=http://localhost:3001

# Trust N proxy hops (set to 1+ behind a load balancer/CDN so req.ip and
# rate limiting key off the real client IP). 0 = do not trust any proxy.
TRUST_PROXY=0

# Cloudinary (Phase 3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Super admin seed (used by `npm run prisma:seed`)
SEED_ADMIN_EMAIL=admin@lotusorium.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Lotusorium Admin
